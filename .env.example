# Seven Desk - referencia de variaveis publicas para instalacao Docker na VPS
# Arquivo de exemplo: NAO adicione senhas, chaves privadas, tokens ou connection strings.
# Para preparar a configuracao consumida pelo Docker Compose:
#   cp .env.example deploy/vps/.env
#   chmod 600 deploy/vps/.env
#   cd deploy/vps && docker compose config -q
# O compose carrega deploy/vps/.env quando executado daquele diretorio.
# As credenciais reais sao arquivos Docker Secrets em /etc/sevendesk/secrets/.

# Dominio publico e HTTPS / Caddy
SEVEN_WEB_DOMAIN=www.sevendesk.tech
SEVEN_DOWNLOADS_DOMAIN=downloads.sevendesk.tech
SEVEN_SITE_URL=https://www.sevendesk.tech
SEVEN_ACME_EMAIL=sevendesk@sevendesk.tech

# PostgreSQL local (o banco nao publica a porta 5432)
POSTGRES_DB=sevendesk
POSTGRES_USER=sevendesk

# Identificador publico do comerciante InfinitePay - preencher na VPS
# A chave privada vai SOMENTE para /etc/sevendesk/secrets/infinitepay_api_key
INFINITEPAY_HANDLE=

# Servidor remoto; profile "signaling" continua desativado por padrao
SEVEN_ID_HOST=sevendesk.tech
SEVEN_RELAY_HOST=sevendesk.tech

# Valores de referencia da politica de liberacao.
# IMPORTANTE: deploy/vps/compose.yml FORCA estas flags a 0 na configuracao
# atual; alterar os valores abaixo NAO ativa cadastro, licenca ou cobranca.
SEVEN_ACCOUNT_STATUS_ENABLED=0
SEVEN_REGISTRATION_ENABLED=0
SEVEN_PASSWORD_RECOVERY_ENABLED=0
SEVEN_BILLING_ENABLED=0
SEVEN_WEBHOOK_ENABLED=0
SEVEN_LICENSE_API_ENABLED=0
SEVEN_SALES_LAUNCH_APPROVED=0

# Segredos exigidos no host: /etc/sevendesk/secrets/
#   pg_password           - senha de administrador do PostgreSQL
#   app_db_password       - senha do usuario restrito sevendesk_app
#   auth_secret           - segredo Better Auth (minimo 32 caracteres)
#   smtp_password         - senha do e-mail oficial da Hostinger
#   infinitepay_api_key   - chave de API da InfinitePay
#
# SMTP Hostinger fixado no backend:
#   host: smtp.hostinger.com
#   porta: 465 / TLS
#   remetente: Seven Desk <sevendesk@sevendesk.tech>
# O arquivo .env NAO deve receber SMTP_PASSWORD nem INFINITEPAY_API_KEY.
#
# Backup cifrado: configurar BACKUP_DIR e AGE_RECIPIENT ao executar
# deploy/vps/backup-encrypted.sh. A chave privada age fica fora da VPS.
