+++ b/src/seven_license.rs
@@ -0,0 +1,87 @@
+use hbb_common::tokio::sync::Semaphore;
+use once_cell::sync::Lazy;
+use reqwest::{Client, StatusCode, Url};
+use serde::Deserialize;
+use std::{env, time::Duration};
+
+enum Endpoint {
+    Disabled,
+    Invalid,
+    Enabled(Url),
+}
+
+static ENDPOINT: Lazy<Endpoint> = Lazy::new(|| match env::var("SEVEN_LICENSE_URL") {
+    Err(env::VarError::NotPresent) => Endpoint::Disabled,
+    Ok(value) => parse_endpoint(&value).map_or(Endpoint::Invalid, Endpoint::Enabled),
+    Err(_) => Endpoint::Invalid,
+});
+static CLIENT: Lazy<Option<Client>> = Lazy::new(|| {
+    Client::builder()
+        .timeout(Duration::from_secs(4))
+        .redirect(reqwest::redirect::Policy::none())
+        .build()
+        .ok()
+});
+static IN_FLIGHT: Lazy<Semaphore> = Lazy::new(|| Semaphore::new(64));
+
+#[derive(Deserialize)]
+struct Decision {
+    allowed: bool,
+}
+
+fn parse_endpoint(value: &str) -> Option<Url> {
+    let url = Url::parse(value).ok()?;
+    if url.scheme() != "https"
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.path() != "/api/license"
+        || url.query().is_some()
+        || url.fragment().is_some()
+    {
+        return None;
+    }
+    Some(url)
+}
+
+pub async fn allows(token: &str) -> bool {
+    let url = match &*ENDPOINT {
+        Endpoint::Disabled => return true,
+        Endpoint::Invalid => return false,
+        Endpoint::Enabled(url) => url,
+    };
+    if token.is_empty()
+        || token.len() > 8192
+        || !token.bytes().all(|byte| (0x21..=0x7e).contains(&byte))
+    {
+        return false;
+    }
+    let client = match &*CLIENT {
+        Some(client) => client,
+        None => return false,
+    };
+    let _permit = match IN_FLIGHT.try_acquire() {
+        Ok(permit) => permit,
+        Err(_) => return false,
+    };
+    match client.get(url.clone()).bearer_auth(token).send().await {
+        Ok(response) if response.status() == StatusCode::OK => response
+            .json::<Decision>()
+            .await
+            .map(|decision| decision.allowed)
+            .unwrap_or(false),
+        _ => false,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::parse_endpoint;
+
+    #[test]
+    fn license_endpoint_requires_https_and_exact_route() {
+        assert!(parse_endpoint("https://www.sevendesk.tech/api/license").is_some());
+        assert!(parse_endpoint("http://www.sevendesk.tech/api/license").is_none());
+        assert!(parse_endpoint("https://www.sevendesk.tech/other").is_none());
+        assert!(parse_endpoint("https://user@www.sevendesk.tech/api/license").is_none());
+    }
+}
