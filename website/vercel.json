{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(conta|entrar|cadastro|recuperar-senha|redefinir-senha|pagamento-retorno)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(favicon.svg|styles.css|script.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth-email-webhook",
      "destination": "/api/auth-config"
    },
    {
      "source": "/entrar",
      "destination": "/conta"
    },
    {
      "source": "/cadastro",
      "destination": "/conta"
    },
    {
      "source": "/recuperar-senha",
      "destination": "/conta"
    },
    {
      "source": "/redefinir-senha",
      "destination": "/conta"
    },
    {
      "source": "/pagamento-retorno",
      "destination": "/pagamento-retorno.html"
    }
  ],
  "redirects": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg",
      "permanent": true
    }
  ]
}
