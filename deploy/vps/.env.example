# Seven Desk | VPS Docker Compose
# Modelo sem segredos. Execute: cp .env.example .env && chmod 600 .env
# Docker Compose usa este arquivo apenas para interpolar valores; nao o publica.
# NAO coloque senhas, tokens, chaves SSH, strings de conexao ou codigos OTP aqui.
# Os dados sigilosos ficam fora do repo, sob /etc/sevendesk/secrets/ (root:root, 0600).

# DNS publico (somente mudar no corte, depois da homologacao)
SEVEN_WEB_DOMAIN=www.sevendesk.tech
SEVEN_DOWNLOADS_DOMAIN=downloads.sevendesk.tech
SEVEN_SITE_URL=https://www.sevendesk.tech
SEVEN_ACME_EMAIL=sevendesk@sevendesk.tech

# PostgreSQL PRIVADO, sem porta externa; mantenha valores apos criar o volume
POSTGRES_DB=sevendesk
POSTGRES_USER=sevendesk

# Requer arquivo na VPS: /etc/sevendesk/secrets/pg_password
# Gerar: sudo install -d -m 700 /etc/sevendesk/secrets
#        sudo sh -c 'umask 077; openssl rand -hex 32 > /etc/sevendesk/secrets/pg_password'
# NUNCA coloque POSTGRES_PASSWORD=... aqui.

# Bandeiras de seguranca: 0 = desligado; nao ative durante a preparacao.
# O compose de staging mantem todas forcadas a 0 (mesmo que .env seja editado).
# Elas so serao conectadas quando autenticacao, licenca e cobranca estiverem homologadas.
SEVEN_ACCOUNT_STATUS_ENABLED=0
SEVEN_REGISTRATION_ENABLED=0
SEVEN_PASSWORD_RECOVERY_ENABLED=0
SEVEN_BILLING_ENABLED=0
SEVEN_WEBHOOK_ENABLED=0
SEVEN_LICENSE_API_ENABLED=0
SEVEN_SALES_LAUNCH_APPROVED=0

# Planejado para a fase seguinte (AINDA NAO ATIVO neste compose):
# SEVEN_DB_HOST=db
# SEVEN_DB_PORT=5432
# SEVEN_DB_NAME=sevendesk
# SEVEN_DB_USER=sevendesk_app
# SEVEN_DB_PASSWORD_FILE=/run/secrets/app_db_password
# SEVEN_AUTH_SECRET_FILE=/run/secrets/auth_secret
# SEVEN_SMTP_HOST=smtp.hostinger.com
# SEVEN_SMTP_PORT=465
# SEVEN_SMTP_USER=sevendesk@sevendesk.tech
# SEVEN_SMTP_FROM=Seven Desk <sevendesk@sevendesk.tech>
# SEVEN_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# INFINITEPAY_HANDLE=(identificador da conta)
# INFINITEPAY_API_KEY_FILE=/run/secrets/infinitepay_api_key
# SEVEN_ID_HOST=sevendesk.tech
# SEVEN_RELAY_HOST=sevendesk.tech
# SEVEN_LICENSE_URL=https://www.sevendesk.tech/api/license

# Backup cifrado (passado ao script separadamente; nao sao variaveis do Compose):
# BACKUP_DIR=/mnt/backup-offsite
# AGE_RECIPIENT=age1...  # chave PUBLICA, nunca a privada
