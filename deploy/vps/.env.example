# Seven Desk Docker VPS - safe public configuration only.
# Copy to .env (chmod 600). Never store credentials in .env.
SEVEN_WEB_DOMAIN=www.sevendesk.tech
SEVEN_DOWNLOADS_DOMAIN=downloads.sevendesk.tech
SEVEN_SITE_URL=https://www.sevendesk.tech
SEVEN_ACME_EMAIL=sevendesk@sevendesk.tech

POSTGRES_DB=sevendesk
POSTGRES_USER=sevendesk

# Public InfinitePay merchant identifier (API KEY IS SECRET).
# Do not enable billing until live provider and refunds are homologated.
INFINITEPAY_HANDLE=

# Remote connection host; servers remain in the inactive signaling profile.
SEVEN_ID_HOST=sevendesk.tech
SEVEN_RELAY_HOST=sevendesk.tech

# Deploy gates remain off in compose.yml regardless of these settings:
SEVEN_ACCOUNT_STATUS_ENABLED=0
SEVEN_REGISTRATION_ENABLED=0
SEVEN_PASSWORD_RECOVERY_ENABLED=0
SEVEN_BILLING_ENABLED=0
SEVEN_WEBHOOK_ENABLED=0
SEVEN_LICENSE_API_ENABLED=0
# Breaking compatibility gate for legacy installers.
# Keep 1 until Windows/Linux/macOS/Android packages and new signaling identity
# are tested. Switch to 2 ONLY at the signed release/server cutover;
# generation-1 activations then fail server-side. Invalid values fail closed.
SEVEN_ACTIVATION_GENERATION=1
SEVEN_SALES_LAUNCH_APPROVED=0

# Credentials are mounted as Docker secrets, not injected through .env:
# /etc/sevendesk/secrets/pg_password
# /etc/sevendesk/secrets/app_db_password
# /etc/sevendesk/secrets/auth_secret
# /etc/sevendesk/secrets/smtp_password
# /etc/sevendesk/secrets/infinitepay_api_key
#
# SMTP: smtp.hostinger.com:465 using sevendesk@sevendesk.tech.
# The password belongs ONLY in smtp_password. Do not expose in PRs or logs.
# Backups: BACKUP_DIR and AGE_RECIPIENT are supplied to backup-encrypted.sh,
# with age's PRIVATE decryption key stored securely outside the VPS.
